# --- Google Custom Search (Prospect Discovery) ---
# See README.md "Google Cloud Console Setup" section for how to get these, free.
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CX=your_search_engine_id_here

# --- Email Verification Mode ---
# "smtp"    -> raw MX lookup + HELO/MAIL FROM/RCPT TO handshake (works locally, usually
#              BLOCKED on Vercel/AWS Lambda because outbound port 25 is closed by default)
# "api"     -> calls a free-tier third-party verification API instead (fill in below
#              once you pick one, e.g. a provider with a free monthly quota)
VERIFY_MODE=smtp

# Only needed if VERIFY_MODE=api
VERIFY_API_KEY=
VERIFY_API_URL=
